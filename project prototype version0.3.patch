+      }
+      var remedyText = t.remedyLabel + ": " + latestDisease.remedy[currentLanguage];
+
+      // Soil pH warning (checks whether the value is inside the range).
+      var phText;
+      if (isNaN(latestPh)) {
+        phText = t.phEnter;
+      } else if (latestPh >= latestDisease.phMin && latestPh <= latestDisease.phMax) {
+        // Replace the {value} placeholder with the real pH number.
+        phText = t.phGood.replace("{value}", latestPh);
+      } else {
+        phText = t.phWarning.replace("{value}", latestPh)
+                            .replace("{min}", latestDisease.phMin)
+                            .replace("{max}", latestDisease.phMax);
+      }
+
+      // Soil moisture display.
+      var moistureText;
+      if (isNaN(latestMoisture)) {
+        moistureText = t.moistureEnter;
+      } else {
+        moistureText = t.moistureText.replace("{value}", latestMoisture);
+      }
+
+      // Write everything into the output section.
+      document.getElementById("resultDisease").textContent = diseaseText;
+      document.getElementById("resultConfidence").textContent = confidenceText;
+      document.getElementById("resultRemedy").textContent = remedyText;
+      document.getElementById("resultPh").textContent = phText;
+      document.getElementById("resultMoisture").textContent = moistureText;
+    }
+
+    // ================================================================
+    // DIAGNOSE FUNCTION
+    // Runs when the user clicks "Diagnose Crop Health".
+    // ================================================================
+    function diagnose() {
+      // 1. Read the selected crop and the entered soil numbers.
+      var selectedCrop = document.getElementById("cropSelect").value;
+      var phValue = Number(document.getElementById("phInput").value);
+      var moistureValue = Number(document.getElementById("moistureInput").value);
+
+      // 2. Collect all checked symptom keys into an array.
+      var checkedSymptoms = [];
+      var symptomBoxes = document.querySelectorAll(".symptom");
+      for (var i = 0; i < symptomBoxes.length; i++) {
+        if (symptomBoxes[i].checked) {
+          checkedSymptoms.push(symptomBoxes[i].value);
+        }
+      }
+
+      // 3. Find the disease that matches the checked symptoms best.
+      var bestDisease = null;
+      var bestPercent = -1;   // start low so even 0% can beat it
+
+      for (var j = 0; j < cropDatabase.length; j++) {
+        var currentDisease = cropDatabase[j];
+
+        // Only look at diseases that affect the chosen crop.
+        if (currentDisease.crop === selectedCrop) {
+
+          // Count how many of this disease's required symptoms were ticked.
+          var matchCount = 0;
+          for (var k = 0; k < currentDisease.symptoms.length; k++) {
+            if (checkedSymptoms.indexOf(currentDisease.symptoms[k]) !== -1) {
+              matchCount++;
+            }
+          }
+
+          // Confidence = matched symptoms / all symptoms of the disease.
+          var percent = Math.round(
+            (matchCount / currentDisease.symptoms.length) * 100
+          );
+
+          // Keep the disease with the highest confidence.
+          if (percent > bestPercent) {
+            bestPercent = percent;
+            bestDisease = currentDisease;
+          }
+        }
+      }
+
+      // 4. Save the result so it can be re-rendered in any language.
+      latestDisease = bestDisease;
+      latestPercent = bestPercent;
+      latestPh = phValue;
+      latestMoisture = moistureValue;
+      hasResult = true;
+
+      // 5. Show and fill the output section in the current language.
+      document.getElementById("outputSection").style.display = "block";
+      renderResult();
+    }
+
+    // ================================================================
+    // LISTEN FUNCTION (Web Speech API / Voice Engine)
+    // Reads the remedy out loud using the browser's built-in speech.
+    // utterance.lang is picked from speechLangCodes so the device
+    // speaks the correct native accent for the selected language.
+    // ================================================================
+    function listenRemedy() {
+      // Make sure the browser supports speech.
+      if ("speechSynthesis" in window && latestDisease) {
+        var utterance = new SpeechSynthesisUtterance(
+          latestDisease.remedy[currentLanguage]
+        );
+        utterance.lang = speechLangCodes[currentLanguage];   // e.g. "hi-IN"
+        utterance.rate = 1;        // normal reading speed
+        window.speechSynthesis.speak(utterance);
+      } else {
+        // Fallback message (only shown if there is no result yet).
+        alert("Please run a diagnosis first.");
+      }
+    }
+
+    // ================================================================
+    // WIRE UP THE CONTROLS
+    // ================================================================
+    var languageSelect = document.getElementById("languageSelect");
+    languageSelect.addEventListener("change", updateLanguage);
+
+    var diagnoseButton = document.getElementById("diagnoseButton");
+    diagnoseButton.addEventListener("click", diagnose);
+
+    var listenButton = document.getElementById("listenButton");
+    listenButton.addEventListener("click", listenRemedy);
+
+    // Draw the default (English) labels on page load.
+    updateLanguage();
+  </script>
+</body>
+</html>
